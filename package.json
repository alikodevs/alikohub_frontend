{
  "name": "alikohub-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "domains/*/frontend",
    "domains/academy/*",
    "domains/alikowash",
    "libraries/*"
  ],
  "main": "domains/general/frontend/index.html",
  "scripts": {
    "dev:general": "npm --prefix domains/general/frontend run dev",
    "dev:academy": "npm --prefix domains/academy/academy_frontend run dev",
    "dev:consultancy": "npm --prefix domains/consultancy/frontend run dev",
    "dev:events": "npm --prefix domains/events/frontend run dev",
    "dev:careers": "npm --prefix domains/careers/frontend run dev",
    "build": "nx run-many -t build"
  },
  "dependencies": {
    "nx": "^21.2.2",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.6.3",
    "tailwind-scrollbar": "^4.0.2"
  }
}
